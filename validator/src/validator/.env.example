# --- Validator service configuration ---

# REQUIRED. Shared secret used to sign validator responses.
# Generate a strong value for production:
#   openssl rand -hex 32
VALIDATOR_SHARED_SECRET=dev-shared-secret-change-me

# Connection token time-to-live in seconds (default: 300)
CONNECTION_TOKEN_TTL=300

# Match session time-to-live in seconds (default: 3600)
MATCH_SESSION_TTL=3600

# HTTP + Socket.IO + MCP port (default: 3000).
# The run-validator skill scripts launch on 5555.
PORT=5555

# Auth: the validator binds match-init and the Socket.IO handshake to the
# Snapser gateway's validated User-Id header (must equal player_id). There is
# no bypass switch — locally there's no gateway, so callers self-stamp a
# matching User-Id (see game/scenes/main.gd). api-key/internal callers pass
# without user binding.

# --- Currency awards (Snapser Inventory snap s2s) ---
# Awards auto-select a transport: the platform-injected internal route
# (SNAPEND_INVENTORY_HTTP_URL + SNAPEND_INTERNAL_HEADER — present only inside
# the snapend, never set these locally), else gateway + api-key, else awards
# are a logged no-op (the local-dev default; validation is unaffected).

# Public gateway base for the api-key transport (default shown).
#SNAPSER_GATEWAY_URL=https://gateway.snapser.com/c4n1awfs

# Auth-snap api-key with access to the Inventory snap. Leave unset locally.
#SNAPSER_API_KEY=
