# --- Validator service configuration ---

# REQUIRED. Shared secret used to sign validator responses and verify
# inbound signatures. Generate a strong value for production:
#   openssl rand -hex 32
VALIDATOR_SHARED_SECRET=dev-shared-secret-change-me

# Connection token time-to-live in seconds (default: 300)
CONNECTION_TOKEN_TTL=300

# Match session time-to-live in seconds (default: 3600)
MATCH_SESSION_TTL=3600

# HTTP + Socket.IO + MCP port (default: 3000).
# The run-validator skill scripts launch on 5555.
PORT=5555

# When true, skips signature verification on /api/match/init.
# DEV ONLY — never enable in production.
DEV_MODE=true
