# --- Validator service configuration ---

# REQUIRED. Shared secret used to sign validator responses.
# Generate a strong value for production:
#   openssl rand -hex 32
VALIDATOR_SHARED_SECRET=dev-shared-secret-change-me

# Match session time-to-live in seconds (default: 3600)
MATCH_SESSION_TTL=3600

# HTTP + Hermes-emulation WS + MCP port (default: 3000).
# The run-validator skill scripts launch on 5555.
PORT=5555

# gRPC ValidatorService port (default: 8081; same deployed, declared as the
# BYOSnap profile's internal "grpc" port).
GRPC_PORT=8081

# Auth: every RPC binds the gateway-validated identity to the match owner
# (player_id). There is no bypass switch — locally there's no gateway, so the
# Hermes-emulation endpoint's ?token= query param IS the self-stamped player id
# (see game/scenes/main.gd). api-key/internal callers pass without user binding.
