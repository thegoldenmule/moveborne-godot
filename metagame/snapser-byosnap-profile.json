{
  "name": "byosnap-metagame",
  "description": "Meta-game service scaffold: gateway ping + internal snap-check proofs",
  "platform": "linux/arm64",
  "language": "go",
  "prefix": "/v1",
  "ingress": {
    "external_port": {
      "name": "http",
      "port": 8080
    },
    "internal_ports": []
  },
  "readiness_probe_config": {
    "initial_delay_seconds": 5,
    "path": "/health"
  },
  "dev_template": {
    "cpu": 250,
    "memory": 0.25,
    "min_replicas": 1,
    "cmd": "",
    "args": [],
    "env_params": [
      {
        "key": "SNAPSER_ENVIRONMENT",
        "value": "DEVELOPMENT"
      },
      {
        "key": "PORT",
        "value": "8080"
      },
      {
        "key": "BYOSNAP_BASE_PATH",
        "value": "/v1/byosnap-metagame"
      }
    ],
    "hpa": null
  },
  "stage_template": {
    "cpu": 250,
    "memory": 0.25,
    "min_replicas": 1,
    "cmd": "",
    "args": [],
    "env_params": [
      {
        "key": "SNAPSER_ENVIRONMENT",
        "value": "STAGING"
      },
      {
        "key": "PORT",
        "value": "8080"
      },
      {
        "key": "BYOSNAP_BASE_PATH",
        "value": "/v1/byosnap-metagame"
      }
    ],
    "hpa": null
  },
  "prod_template": {
    "cpu": 250,
    "memory": 0.25,
    "min_replicas": 1,
    "cmd": "",
    "args": [],
    "env_params": [
      {
        "key": "SNAPSER_ENVIRONMENT",
        "value": "PRODUCTION"
      },
      {
        "key": "PORT",
        "value": "8080"
      },
      {
        "key": "BYOSNAP_BASE_PATH",
        "value": "/v1/byosnap-metagame"
      }
    ],
    "hpa": null
  }
}
